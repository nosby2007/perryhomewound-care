rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function activeAdminDoc() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    function activeAdminUser() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.active == true
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
    function isAdmin() { return activeAdminDoc() || activeAdminUser(); }
    function portalOwns(patientId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/portalUsers/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/portalUsers/$(request.auth.uid)).data.active == true
        && firestore.get(/databases/(default)/documents/portalUsers/$(request.auth.uid)).data.patientId == patientId;
    }
    function validMarketingImage() {
      return request.resource != null
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }
    function validClinicalDocument() {
      return request.resource != null
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType.matches('(application/pdf|image/jpeg|image/png|image/webp)');
    }

    match /marketing/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && validMarketingImage();
      allow delete: if isAdmin();
    }
    match /blog/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && validMarketingImage();
      allow delete: if isAdmin();
    }

    // Referral intake documents are never public and remain admin-only.
    match /referrals/{referralId}/{allPaths=**} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validClinicalDocument();
      allow delete: if isAdmin();
    }

    // Patient portal documents are readable only by the linked patient account or PHWC admin.
    // Only PHWC admin can publish/change portal documents.
    match /patientPortal/{patientId}/{allPaths=**} {
      allow read: if isAdmin() || portalOwns(patientId);
      allow create, update: if isAdmin() && validClinicalDocument();
      allow delete: if isAdmin();
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
