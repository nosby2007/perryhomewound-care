{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": ["firebase.json","**/.*","**/node_modules/**","**/*.md"],
    "rewrites": [
      { "source": "/admin", "destination": "/admin/admin.html" },
      { "source": "/login", "destination": "/admin/login/admin-login.html" },
      { "source": "/admin/tasks",     "destination": "/admin/tasks.html" },
      { "source": "/admin/bookings",  "destination": "/admin/bookings.html" },
      { "source": "/admin/contacts",  "destination": "/admin/contacts.html" },
      { "source": "/admin/referrals", "destination": "/admin/referrals.html" },
      { "source": "/admin/crm",       "destination": "/admin/crm.html" },
      { "source": "/admin/social-studio", "destination": "/admin/social-studio.html" },
      { "source": "/admin/blog-studio", "destination": "/admin/blog-studio.html" },
      { "source": "/admin/users",     "destination": "/admin/users.html" },
      { "source": "/blog", "destination": "/blog.html" },
      { "source": "/blog/post", "destination": "/blog-post.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
          { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
        ]
      },
      {
        "source": "/admin/**",
        "headers": [
          { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      },
      { "source": "**/*.@(css|js)", "headers":[{"key":"Cache-Control","value":"public, max-age=3600"}] },
      { "source": "**/*.@(jpg|jpeg|gif|webp|svg|png)", "headers":[{"key":"Cache-Control","value":"public, max-age=86400"}] }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
